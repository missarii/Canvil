# ---------------------------------------------------------------------------
# Canvil environment
# Copy to `.env` and fill in what you need. Everything here is optional except
# one model provider (or none, if you only use the deterministic subcommands).
# ---------------------------------------------------------------------------

# --- Model provider -------------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, Azure, OpenRouter, Together,
# vLLM, LM Studio, Ollama (`http://localhost:11434/v1`).
CANVIL_MODEL=gpt-4.1-mini
CANVIL_MODEL_PROVIDER=openai          # openai | fake
CANVIL_MODEL_BASE_URL=                # e.g. http://localhost:11434/v1 for Ollama
OPENAI_API_KEY=
CANVIL_TEMPERATURE=0

# --- Live research --------------------------------------------------------
# web_search picks the first configured provider. Without one, web search is
# disabled and Canvil falls back to local knowledge only.
TAVILY_API_KEY=
BRAVE_API_KEY=
# Self-hosted SearxNG instance, e.g. http://localhost:8888
CANVIL_SEARXNG_URL=

# --- GitHub ---------------------------------------------------------------
# Optional but strongly recommended: raises rate limits from 60 to 5000 req/h.
GITHUB_TOKEN=

# --- Sandbox --------------------------------------------------------------
# docker = run commands inside a throwaway container (recommended)
# local  = run on the host, constrained by the command allowlist
CANVIL_SANDBOX=docker
CANVIL_SANDBOX_IMAGE=node:22-bookworm-slim
CANVIL_SANDBOX_NETWORK=false
CANVIL_COMMAND_TIMEOUT_MS=300000
