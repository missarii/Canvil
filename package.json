{
  "name": "canvil",
  "version": "0.1.0",
  "private": true,
  "description": "Canvil - an autonomous coding agent that plans, researches, writes, tests and reviews software changes.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "canvil": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/openai": "^1.5.13",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
